{
  "name": "@migrateck/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/write-release-manifest.mjs --service migrateck-platform-api --source src --artifact dist --output dist/release-manifest.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "start:webhook-worker": "node dist/webhook-worker.js",
    "start:usage-worker": "node dist/usage-worker.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1022.0",
    "@aws-sdk/s3-request-presigner": "3.1022.0",
    "@migrateck/billing-core": "workspace:*",
    "fastify": "^5.10.0",
    "pg": "^8.20.0",
    "stripe": "^17.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
