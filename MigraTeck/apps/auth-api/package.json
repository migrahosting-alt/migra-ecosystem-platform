{
  "name": "@migrateck/auth-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/auth-api/src/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:seed": "tsx src/seed.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "verify:prisma-client": "node scripts/verify-prisma-client.mjs",
    "verify:auth-health": "node scripts/verify-auth-health.mjs",
    "build:release": "tsc -p tsconfig.json && node scripts/verify-prisma-client.mjs"
  },
  "dependencies": {
    "@migrateck/billing-core": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "7.9.1",
    "argon2": "^0.43.0",
    "fastify": "^5.10.0",
    "jose": "^6.0.11",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^7.9.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
