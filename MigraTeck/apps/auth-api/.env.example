# MigraAuth API — Environment
# Copy to .env and fill in values.

# ── Server ──────────────────────────────────────────────────────────
AUTH_PORT=4000
AUTH_HOST=0.0.0.0
AUTH_PUBLIC_URL=http://localhost:4000
AUTH_WEB_URL=http://localhost:4100
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────
AUTH_DATABASE_URL=postgresql://migra:migra_dev_password@127.0.0.1:5432/auth_migrateck?schema=public

# ── JWT / Signing (prod: use RSA key pair) ──────────────────────────
AUTH_JWT_ISSUER=https://auth.migrateck.com
AUTH_JWT_SECRET=dev-only-change-me-in-production-32-chars!!
# AUTH_JWT_PRIVATE_KEY=<RSA PKCS8 PEM>
# AUTH_JWT_PUBLIC_KEY=<RSA SPKI PEM>

# ── Token lifetimes (seconds) ──────────────────────────────────────
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_CODE_TTL=300
AUTH_EMAIL_VERIFY_TTL=3600
AUTH_PASSWORD_RESET_TTL=1800
AUTH_SESSION_TTL=604800

# ── Cookie ──────────────────────────────────────────────────────────
# AUTH_COOKIE_DOMAIN=.migrateck.com
AUTH_COOKIE_SECURE=false
AUTH_SESSION_COOKIE=migraauth_session

# ── CORS ────────────────────────────────────────────────────────────
AUTH_CORS_ORIGINS=http://localhost:4100,http://localhost:3000,http://localhost:3200

# ── Email / SMTP ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
AUTH_EMAIL_FROM=MigraTeck Account <noreply@auth.migrateck.com>

# ── Rate limits ────────────────────────────────────────────────────
AUTH_LOGIN_RATE_LIMIT=10
AUTH_SIGNUP_RATE_LIMIT=5
AUTH_GLOBAL_RATE_LIMIT=100

# ── Security ───────────────────────────────────────────────────────
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_DURATION=900

# Billing (Stripe)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CATALOG_VERSION=v1
