{
  "name": "@migrapilot/shared-types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/contracts.js",
  "types": "./src/contracts.ts",
  "exports": {
    ".": {
      "types": "./src/contracts.ts",
      "default": "./dist/contracts.js"
    },
    "./transcription": {
      "types": "./src/transcription.ts",
      "default": "./dist/transcription.js"
    },
    "./composer-capabilities": {
      "types": "./src/composer-capabilities.ts",
      "default": "./dist/composer-capabilities.js"
    },
    "./anonymous-quota": {
      "types": "./src/anonymous-quota.ts",
      "default": "./dist/anonymous-quota.js"
    },
    "./user-preferences": {
      "types": "./src/user-preferences.ts",
      "default": "./dist/user-preferences.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  }
}
