  "description": "Typed client for the Shared Compute Authority. Contract only \u2014 no provider, scheduling, evidence or lifecycle logic.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
