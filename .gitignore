
# ===========================
# Migra Ecosystem Platform Repo (Allowlist)
# Track ONLY:
#   - .github/**
#   - .migra/**
#   - infra/nginx/**
#   - migra-infra/wordpress/migrastacks-plugins/**
# ===========================

# Ignore everything by default
*

# Always keep gitignore
!.gitignore

# Canonical npm workspace lockfile — required for reproducible enterprise builds.
!/package-lock.json

# Allow .github (agents + workflows)
!.github/
!.github/**

# Allow MigraAgent artifacts
!.migra/
!.migra/**

# Allow MigraAuth design/hardening documentation
!/docs/
!/docs/migraauth/
!/docs/migraauth/**

# Allow ONLY nginx infra tree
!infra/
!infra/nginx/
!infra/nginx/**

# Allow MigraStacks enterprise WordPress plugins
!migra-infra/
!migra-infra/wordpress/
!migra-infra/wordpress/migrastacks-plugins/
!migra-infra/wordpress/migrastacks-plugins/**

# --- Coding-assistant capability benchmark (allowlist) ---
# The fixture, tasks, hidden verification, harness and recorded results. Per-run
# brain logs are excluded by benchmarks/coding-assistant/.gitignore.
!/benchmarks/
!/benchmarks/**

# --- MigraPilot apps (allowlist) ---
!/apps/
!/apps/migrapilot-console/
!/apps/migrapilot-console/**
!/apps/migrapilot-runner-local/
!/apps/migrapilot-runner-local/**
!/apps/migrapilot-runner-server/
!/apps/migrapilot-runner-server/**
!/apps/migrapilot-desktop/
!/apps/migrapilot-desktop/**
!/apps/migrapilot-endpoint-agent-windows/
!/apps/migrapilot-endpoint-agent-windows/**
!/apps/migrapilot-vscode-extension/
!/apps/migrapilot-vscode-extension/**
# Canonical MigraPilot VS Code extension — track its source. Build output
# (out/, *.js), node_modules, logs, .env are re-excluded by its own
# apps/migrapilot-vscode/.gitignore.
!/apps/migrapilot-vscode/
!/apps/migrapilot-vscode/**
# Canonical brain-service (MigraAI Engine) — track its source. Build output
# (dist/), node_modules, .env, *.db and eval artifacts are re-excluded by its
# own apps/brain-service/.gitignore.
!/apps/brain-service/
!/apps/brain-service/**
# Canonical VS Code extension — track its source. Build output (dist/, out/),
# node_modules, *.vsix and .env are re-excluded by its own
# apps/vscode-extension/.gitignore.
!/apps/vscode-extension/
!/apps/vscode-extension/**
# Canonical MigraPilot consumer web app (Next.js App Router) — track its source.
# Build output (.next/), node_modules, next-env.d.ts, tsconfig.tsbuildinfo and
# .env are re-excluded by its own apps/migrapilot-consumer/.gitignore.
!/apps/migrapilot-consumer/
!/apps/migrapilot-consumer/**

# Migra Engineer is NOT in this repository. Its authoritative home is the
# separate MigraAI-Engineer repo (P:\MigraAI-Engineer). A short-lived
# apps/migra-engineer/ was created here before that repo was discovered; the
# work was migrated into evaluations/mkes/stress and evaluations/
# conversation-quality there, and the duplicate removed. Two Migra Engineer
# implementations is the expensive outcome — do not re-add one here.
# apps/pilot-web IS the product chat surface (chat.migrateck.com lane) and 122 of its
# files are already tracked — but the directory was never allowlisted, so git silently
# refused every NEW file added to it while happily accepting edits to the old ones. A
# module can be written, typechecked, gated and verified and still never reach a commit.
# Allowlist it explicitly so the ignore file matches what the repo actually tracks.
!/apps/pilot-web/
!/apps/pilot-web/**

# ...but the allowlist above also uncovers pilot-web's RUNTIME and GENERATED output, which
# was only invisible because the whole directory was ignored. Re-exclude it explicitly:
# a python venv, local run/scratch state, tool output and build artefacts are not source.
/apps/pilot-web/.pilot-data/
/apps/pilot-web/.pilot-scratch/
/apps/pilot-web/.pilot-sd/
/apps/pilot-web/.playwright-mcp/
/apps/pilot-web/.next/
/apps/pilot-web/tsconfig.tsbuildinfo
/apps/pilot-web/next-env.d.ts
/apps/pilot-web/*.png

!/apps/**/package.json
!/apps/**/package-lock.json
!/apps/**/pnpm-lock.yaml
!/apps/**/yarn.lock
!/apps/**/tsconfig.json
!/apps/**/README.md

# Stage 2B Agent Mode protocol contract. Keep this explicit because the root
# allowlist otherwise hides a source file exported by the tracked protocol index.
!/packages/
!/packages/protocol/
!/packages/protocol/src/
!/packages/protocol/src/agentMode.ts

# --- MigraTeck web (allowlist) ---
!/MigraTeck/
!/MigraTeck/**

# Runtime state (never commit)
/apps/migrapilot-console/.data/
/apps/migrapilot-runner-local/.migrapilot/
/apps/migrapilot-runner-server/.migrapilot/

# ---- Never commit secrets/keys ----
*.key
*.pem
*.p12
*.pfx
*.jks
.env
.env.*
secrets/
private/
**/id_rsa
**/id_ed25519

# ---- Common junk ----
.DS_Store
Thumbs.db
.vscode/
.vscode-server/
.idea/
*.swp

# ---- Big artifacts ----
*.zip
*.tar
*.tar.gz
*.tgz
*.log
dump.rdb
test-results/
coverage/
node_modules/
dist/
build/
.next/
.cache/
tmp/
logs/
backups/
_tools/
_security_scan_outputs/

# Claude Code local (uncommitted) personal settings
.claude/settings.local.json

# Accidentally-committed Chrome/Chromium user-data directories from Lighthouse runs.
# These were captured on Windows, so the path is a literal name containing a drive letter.
# Narrow by design: it matches ONLY the generated `lighthouse.<digits>` profile directories,
# never Lighthouse report output (*.report.html / *.report.json) or app configuration.
MigraTeck/C:\\Users\\*\\AppData\\Local\\lighthouse.[0-9]*/
**/lighthouse.[0-9]*/Default/
