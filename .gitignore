
# ===========================
# Migra Ecosystem Platform Repo (Allowlist)
# Track ONLY:
#   - .github/**
#   - .migra/**
#   - infra/nginx/**
#   - migra-infra/wordpress/migrastacks-plugins/**
# ===========================

# Ignore everything by default
*

# Always keep gitignore
!.gitignore

# Canonical npm workspace lockfile — required for reproducible enterprise builds.
!/package-lock.json

# MigraPilot release tooling. The deploy path must be reproducible from repo
# state, so the scripts that perform it have to live in the repo. Only these
# files are tracked — the rest of scripts/ stays ignored deliberately.
#
# This is an allowlist ignore (`*` at the top), so a NEW release script is
# silently untracked until it is named here. That already happened once: the
# consumer script was written, deployed twice, and committed — except git had
# quietly dropped it, and the commit shipped only the docs.
!/scripts/
!/scripts/brain-release.sh
!/scripts/build-brain-payload.sh
!/scripts/install-brain-deploy-runner.sh
!/scripts/consumer-release.sh
!/scripts/release-retention.sh
# The single definition of "can this release actually serve?", shared by
# release-retention.sh and BOTH deploy scripts. Untracked it would break a
# clean clone the moment a deploy sourced it — and retention refuses to run
# without it, so it is not optional tooling.
!/scripts/release-completeness.sh
!/scripts/test-release-completeness.sh
# The proxy's upload ceiling is production configuration that the app's own
# MAX_UPLOAD_MB must agree with, so the script that sets it and the probe that
# proves it belong beside the code rather than in someone's shell history.
!/scripts/vm102-raise-upload-ceiling.sh
!/scripts/verify-upload-ceiling.sh
# Registers a completed corpus extraction against the source PDF's hash so
# ingestion never repeats work already paid for. Belongs with the code that
# reads the registry, not in a shell history.
!/scripts/register-corpus-extraction.mjs

# Kreyòl extraction pipeline. Same rule as the release scripts: the pass that
# produces the language corpus must be reproducible from repo state.
!/services/
!/services/kreyol-extract/
!/services/kreyol-extract/*.py

# Allow .github (agents + workflows)
!.github/
!.github/**

# Allow MigraAgent artifacts
!.migra/
!.migra/**

# Allow MigraAuth design/hardening documentation
!/docs/
!/docs/migraauth/
!/docs/migraauth/**

# docs/governance holds CHARTER.md and governance-status.json — the doctrine every
# architecture decision is checked against, and the machine-readable ledger the Control
# Center reads. The root allowlist ignored both, so neither had ever been committed:
# no history, no diff, no review, and no way to satisfy the charter's own change-control
# clause requiring the previous version be preserved. That is also why the ledger was
# able to sit at charter_version 1.1 for a day after v1.2 came into force without anyone
# seeing it — a file nobody can diff is a file nobody notices aging.
# Charter IV §11: source required by production that Git ignores is a release-blocking defect.
!/docs/governance/
!/docs/governance/**

# docs/migrapilot holds the MigraPilot runbooks — 8 are already tracked, but the root
# allowlist hid every NEW one, so a production deployment procedure could be written and
# never committed. Markdown only.
!/docs/migrapilot/
!/docs/migrapilot/*.md
# A runbook's executable half belongs with it. "Markdown only" reopened the very
# hole the comment above describes: two provisioning scripts were written, `git
# add` skipped them silently, the commit succeeded naming them, and they existed
# on exactly one disk. Extension-scoped, like the *.md line, so the next one does
# not have to rediscover this.
!/docs/migrapilot/*.sh
# 🚨 AND THE .mjs HALF, FOR THE SAME REASON THE .sh LINE EXISTS.
#
# `workspace-digest.mjs` is invoked by stage-workspace-deps.sh during every
# release. It was never tracked, so it lived on exactly one disk — the failure
# the comment above says it was written to prevent, repeated one extension
# later. A clean checkout could not deploy: the consumer release aborted with
# `scp: stat local ".../workspace-digest.mjs": No such file or directory`.
!/docs/migrapilot/*.mjs
# The canonical machine-readable status. Named explicitly rather than widening the
# allowlist to *.json, so no other generated JSON slips into the repository with it.
!/docs/migrapilot/MIGRAPILOT_STATUS.json

# Evidence packages: the recorded proof behind a PROVEN_LIVE / qualification
# claim. Tracked deliberately — an evidence file that lives only on one machine
# is not evidence, and the status documents point at these.
!/docs/migrapilot/evidence/
!/docs/migrapilot/evidence/*.json
# 🚨 An allowlist exception does NOT reach into subdirectories — each level has
# to be re-admitted, or a run's evidence folder is silently ignored and the
# claim it supports lives on one machine again.
!/docs/migrapilot/evidence/*/
!/docs/migrapilot/evidence/*/*.md
!/docs/migrapilot/evidence/*/*.json
!/docs/migrapilot/evidence/*/*.psv
# Preserved source, kept as .txt so the test runner never picks it up.
!/docs/migrapilot/evidence/*/*.txt

# The exact text of every scoped elevation grant. The guard in
# .claude/hooks/block-dangerous.sh removes each grant once its slice closes and
# leaves a comment pointing here — but 10 of the 11 documents those comments
# named existed on exactly one disk, so the record of what elevated access was
# granted, used and withdrawn was not actually kept anywhere durable. Scoped to
# the hook-patch documents themselves, not the whole directory.
!/docs/annoupale/
!/docs/annoupale/hook-patch-*.md
!/docs/migracms/
!/docs/migracms/hook-patch-*.md
# A grant's permit/deny suite is the evidence it was actually tested, and it is
# the only artefact that can prove a removed grant is really gone. Same reasoning
# as /docs/migrapilot/*.sh above: the executable half belongs with the document.
!/docs/annoupale/hook-patch-*.sh
!/docs/migracms/hook-patch-*.sh

# Allow ONLY nginx infra tree
!infra/
!infra/nginx/
!infra/nginx/**

# MigraVoice site source + pre-retirement archive (Charter IV §11:
# production source must exist in Git before anything is deleted)
!infra/migravoice/
!infra/migravoice/**

# Allow MigraStacks enterprise WordPress plugins
!migra-infra/
!migra-infra/wordpress/
!migra-infra/wordpress/migrastacks-plugins/
!migra-infra/wordpress/migrastacks-plugins/**

# --- Coding-assistant capability benchmark (allowlist) ---
# The fixture, tasks, hidden verification, harness and recorded results. Per-run
# brain logs are excluded by benchmarks/coding-assistant/.gitignore.
!/benchmarks/
!/benchmarks/**

# --- MigraPilot apps (allowlist) ---
!/apps/
!/apps/migrapilot-console/
!/apps/migrapilot-console/**
!/apps/migrapilot-runner-local/
!/apps/migrapilot-runner-local/**
!/apps/migrapilot-runner-server/
!/apps/migrapilot-runner-server/**
!/apps/migrapilot-desktop/
!/apps/migrapilot-desktop/**
!/apps/migrapilot-endpoint-agent-windows/
!/apps/migrapilot-endpoint-agent-windows/**
!/apps/migrapilot-vscode-extension/
!/apps/migrapilot-vscode-extension/**
# Canonical MigraPilot VS Code extension — track its source. Build output
# (out/, *.js), node_modules, logs, .env are re-excluded by its own
# apps/migrapilot-vscode/.gitignore.
!/apps/migrapilot-vscode/
!/apps/migrapilot-vscode/**
# Canonical brain-service (MigraAI Engine) — track its source. Build output
# (dist/), node_modules, .env, *.db and eval artifacts are re-excluded by its
# own apps/brain-service/.gitignore.
!/apps/brain-service/
!/apps/brain-service/**
# Canonical VS Code extension — track its source. Build output (dist/, out/),
# node_modules, *.vsix and .env are re-excluded by its own
# apps/vscode-extension/.gitignore.
!/apps/vscode-extension/
!/apps/vscode-extension/**
# Canonical MigraPilot consumer web app (Next.js App Router) — track its source.
# Build output (.next/), node_modules, next-env.d.ts, tsconfig.tsbuildinfo and
# .env are re-excluded by its own apps/migrapilot-consumer/.gitignore.
!/apps/migrapilot-consumer/
!/apps/migrapilot-consumer/**

# Migra Engineer is NOT in this repository. Its authoritative home is the
# separate MigraAI-Engineer repo (P:\MigraAI-Engineer). A short-lived
# apps/migra-engineer/ was created here before that repo was discovered; the
# work was migrated into evaluations/mkes/stress and evaluations/
# conversation-quality there, and the duplicate removed. Two Migra Engineer
# implementations is the expensive outcome — do not re-add one here.
# apps/pilot-web IS the product chat surface (chat.migrateck.com lane) and 122 of its
# files are already tracked — but the directory was never allowlisted, so git silently
# refused every NEW file added to it while happily accepting edits to the old ones. A
# module can be written, typechecked, gated and verified and still never reach a commit.
# Allowlist it explicitly so the ignore file matches what the repo actually tracks.
!/apps/pilot-web/
!/apps/pilot-web/**

# Canonical MigraCredit repair operations app - recovered from the live
# app-core deployment and now tracked as the source of truth.
!/apps/migracredit/
!/apps/migracredit/**

# Keep generated output, local secrets, and production data out of source.
/apps/migracredit/.next/
/apps/migracredit/node_modules/
/apps/migracredit/.data/
/apps/migracredit/.backups/
/apps/migracredit/backups/
/apps/migracredit/worker-dist/
/apps/migracredit/.env
/apps/migracredit/.env.*
/apps/migracredit/pass.md/
/apps/migracredit/next-env.d.ts
/apps/migracredit/tsconfig.tsbuildinfo

# ...but the allowlist above also uncovers pilot-web's RUNTIME and GENERATED output, which
# was only invisible because the whole directory was ignored. Re-exclude it explicitly:
# a python venv, local run/scratch state, tool output and build artefacts are not source.
/apps/pilot-web/.pilot-data/
/apps/pilot-web/.pilot-scratch/
/apps/pilot-web/.pilot-sd/
/apps/pilot-web/.playwright-mcp/
/apps/pilot-web/.next/
/apps/pilot-web/tsconfig.tsbuildinfo
/apps/pilot-web/next-env.d.ts
/apps/pilot-web/*.png

# Reviewed out of the pilot-web source baseline (2026-08-21), left on disk for a decision:
#   * two unreferenced design mockups, 3.2 MB of the 3.8 MB in app/assets — no code imports
#     them, and git history is forever. MigraPilot.png (48 refs) and
#     MigraPilot_official_logo.png (1 ref) ARE tracked, because they are used.
#   * EnhancedAssistant.tsx — a one-line placeholder returning the text "Enhanced Assistant
#     Component", imported by nothing. Baselining a placeholder is how it survives.
/apps/pilot-web/app/assets/MigraPilot_Vs_code_Mockup-Draft.png
/apps/pilot-web/app/assets/MigraPilot AI Command Center Dashboard.png
/apps/pilot-web/components/EnhancedAssistant.tsx

!/apps/**/package.json
!/apps/**/package-lock.json
!/apps/**/pnpm-lock.yaml
!/apps/**/yarn.lock
!/apps/**/tsconfig.json
!/apps/**/README.md

# Stage 2B Agent Mode protocol contract. Keep this explicit because the root
# allowlist otherwise hides a source file exported by the tracked protocol index.
!/packages/
!/packages/protocol/
!/packages/protocol/src/
!/packages/protocol/src/agentMode.ts

# @migrapilot/shared-types is a real workspace package — the consumer app depends on it and
# the Command Center's ASR adapter now imports its transcription contract. package.json,
# contracts.ts and tsconfig.json were already tracked, but the root allowlist hid every NEW
# file, so a shared contract could be written, typechecked, tested and still never reach a
# commit. Source only: dist/ and tsbuildinfo stay ignored.
!/packages/shared-types/
!/packages/shared-types/src/
!/packages/shared-types/src/*.ts

# The workbook reader lives in a SUBDIRECTORY, and `src/*.ts` above does not reach one — which is
# the same trap this block was written about, one level deeper. The reader moved here out of the
# consumer app because the Brain reads the same .xlsx files and two readers would disagree about
# what a sheet says the first time either was tuned. It was written, built and green before
# anything noticed it could not be committed.
#
# The .xlsx fixtures are tracked deliberately: they are real Excel output, which is exactly what
# makes them worth having, and nothing in the repo can regenerate them from source.
!/packages/shared-types/src/workbook/
!/packages/shared-types/src/workbook/*.ts
!/packages/shared-types/src/workbook/__fixtures__/
!/packages/shared-types/src/workbook/__fixtures__/*.xlsx

# The Kreyòl ASR orthographic normalizer. It lives in packages/ because TWO runtimes load the
# same bytes — apps/pilot-web/scripts/transcribe.py and services/speech-runtime/server.py, the
# latter being what the consumer MigraPilot app reaches speech through. A copy per app is how
# two surfaces start disagreeing about what a speaker said.
#
# The lexicon snapshot and the regression vectors are tracked ON PURPOSE and are not generated
# artifacts: they ARE the qualified instrument. The .jsonl holds the 94 transcripts the
# precision and harm-rate figures were computed from, and pilot:verify replays them to prove
# the shipped code still matches the code that was measured. Without them the gate would pass
# vacuously on any checkout.
!/packages/kreyol-normalizer/
!/packages/kreyol-normalizer/*.py
!/packages/kreyol-normalizer/*.json
!/packages/kreyol-normalizer/*.jsonl
!/packages/kreyol-normalizer/*.md

# @migraai/compute-client is the typed client for the Shared Compute Authority — the ONE package
# Studio, Brain, Engineer, MigraPilot and the CLI all talk to the authority through. It is a
# contract, not an implementation: no provider, scheduling, evidence or lifecycle logic, enforced
# behaviourally by test/contract-neutrality.mjs rather than asserted in a comment.
#
# It is listed here for exactly the reason the shared-types block above records: this file is an
# ALLOWLIST, so a new shared contract can be written, built, tested and still never reach a
# commit. That happened to this package — it was created, compiled and fully verified while being
# completely invisible to git. Source and tests only; dist/ and tsbuildinfo stay ignored.
!/packages/compute-client/
!/packages/compute-client/src/
!/packages/compute-client/src/*.ts
!/packages/compute-client/test/
!/packages/compute-client/test/*.mjs

# The canonical workspace-tool contract + implementations, shared by the brain and
# the VS Code client. It had tracked files but no allowlist entry, so new tools
# could not be added to the one package that exists to stop them drifting apart.
!/packages/workspace-tools/
!/packages/workspace-tools/src/
!/packages/workspace-tools/src/*.ts
!/packages/workspace-tools/package.json
!/packages/workspace-tools/tsconfig.json
!/packages/compute-client/package.json
!/packages/compute-client/tsconfig.json

# The speech runtime is a real service the Brain delegates to (MIGRAPILOT_SPEECH_RUNTIME_URL).
# Source and docs only — no models, no audio, no caches.
!/services/
!/services/speech-runtime/
!/services/speech-runtime/*.py
!/services/speech-runtime/*.md

# --- MigraTeck web (allowlist) ---
!/MigraTeck/
!/MigraTeck/**

